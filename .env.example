# AURA OS Environment Configuration

AI_PROVIDER=mock          # Options: mock, gemini
GEMINI_API_KEY=your_gemini_api_key_here
DATABASE_PATH=aura_os.db
LOG_LEVEL=INFO
PERMISSION_MODE=interactive # interactive, strict, or permissive
PORT=8000
HOST=127.0.0.1

# Phase 2 Voice Configuration
VOICE_ENABLED=true
WAKE_WORD_ENABLED=true
WAKE_WORD=Aura
WAKE_WORD_SENSITIVITY=0.5
STT_PROVIDER=mock         # mock, local, cloud
STT_LANGUAGE=en-US
TTS_ENABLED=true
TTS_PROVIDER=mock         # mock, local, cloud
TTS_VOICE=default
TTS_SPEED=1.0
VOICE_SESSION_TIMEOUT=30
VOICE_RECORDING_ENABLED=false
MICROPHONE_DEVICE=default
